# SPDX-License-Identifier: GPL-3.0-only
# What an editor should do in this repository; https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The web page, workflows and JSON use two spaces.
[*.{js,css,html,yml,yaml,json}]
indent_size = 2

# Markdown and the notes are wrapped at about 130 columns by hand.
[*.md]
max_line_length = 132

# A patch's context lines must stay byte for byte, trailing blanks included.
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset

# Fuzzing seeds and golden files are data.
[tests/fuzz/corpus/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[*.golden]
trim_trailing_whitespace = unset
insert_final_newline = unset

# PowerShell on Windows reads either line ending; the scripts are kept with LF as the rest.
