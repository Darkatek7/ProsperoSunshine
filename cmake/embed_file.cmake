# Writes a file's bytes as a C++ array: cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P embed_file.cmake
# The array is <name>, its length <name>_size. CMakeLists.txt embeds the relaunch helper payload into the host with it.
file(READ "${INPUT}" HEX HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
file(WRITE "${OUTPUT}"
    "// Generated by cmake/embed_file.cmake\n#include <cstddef>\nextern const unsigned char ${SYMBOL}[] = {${BYTES}};\nextern const std::size_t ${SYMBOL}_size = sizeof ${SYMBOL};\n")
