       /// Reaching this limit will result in a message_size error code.
       std::size_t max_request_streambuf_size = (std::numeric_limits<std::size_t>::max)();
+      /// Whether a request may carry content (Content-Length above 0, or chunked). If false, such a request gets 413 before
+      /// any content is read, so its connection doesn't wait timeout_content for it.
+      bool accept_content = true;
       /// IPv4 address in dotted decimal form or IPv6 address in hexadecimal notation.
       /// If empty, the address will be any address.
       std::string address;
