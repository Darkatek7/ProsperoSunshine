   /**
    * @brief Bind the GameStream UDP and control sockets used for a streaming session.
    */
+  std::shared_ptr<void> hold_ports() {
+    auto ref = broadcast.ref();
+    if (!ref) {
+      return nullptr;
+    }
+    return std::make_shared<decltype(ref)>(std::move(ref));
