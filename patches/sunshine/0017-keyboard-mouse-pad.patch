+  /**
+   * @brief Whether a press goes to the stream's own pad, adding the pad if the press is one of its controls.
+   *
+   * The pad is added here, before the press reaches it, and only for a key or mouse button that is one of its controls
+   * (KeyboardPad::pressed): the mouse's movement and the wheel alone don't add it, so a friend who only watches takes no
+   * player slot, nor the host role. The pad comes the way a controller's does: the lowest free slot, counting toward the
+   * four, and the platform gives it the host's role or a guest's by the client, as any pad's (PS and Create only for the
+   * host's). With no pad free, this press goes to the shared keyboard or mouse, its release with it, and so does
+   * everything else of the client's until a control press keyboard_pad_retry_after later gets a pad, or its next stream.
+   *
+   * @param input Stream input state.
+   * @param press Gives the press to a KeyboardPad.
+   * @return True when the press goes to the pad.
+   */
+  template<class Press>
+  bool keyboard_pad_takes_press(std::shared_ptr<input_t> &input, Press &&press) {
+    const auto now = std::chrono::steady_clock::now();
+    if (!keyboard_pad_possible(*input) || (input->keyboard_pad_failed && now < input->keyboard_pad_retry)) {
+      return false;
+    }
+    if (input->keyboard_pad_open && input->gamepads[0].id >= 0) {
+      return true;
+    }
+    input->keyboard_pad_open = false;
+    // Tried on a copy: modifiers and keys without a control don't add a pad, and while the stream is on the shared ones
+    // they stay there.
+    update_keyboard_pad_profile(*input);
+    auto probe = input->keyboard_pad;
+    press(probe);
+    if (!probe.pressed(now)) {
+      return !input->keyboard_pad_failed;
+    }
+    if (alloc_gamepad(input, 0, {}) < 0) {
+      if (!input->keyboard_pad_failed) {
+        BOOST_LOG(warning) << "No virtual pad free for a client's keyboard and mouse; they go to the shared ones until a press gets one"sv;
+      }
+      input->keyboard_pad_failed = true;
+      input->keyboard_pad_retry = now + keyboard_pad_retry_after;
+      clear_keyboard_pad(*input);
+      return false;
+    }
+    input->keyboard_pad_failed = false;
+    input->keyboard_pad_open = true;
+    input->keyboard_pad_sent = {};
