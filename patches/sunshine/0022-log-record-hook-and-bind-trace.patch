 namespace logging {
   /**
+   * @brief ProsperoSunshine: what the log file gets in place of one record.
+   *
+   * Gets the record's severity and message and returns the records to write instead: none (held back), the record
+   * (rewritten, e.g. without secrets), or summaries of held-back records first. src/log/log_filter.hpp has the rules.
+   */
+  using record_hook_t = std::function<std::vector<std::pair<int, std::string>>(int severity, std::string message)>;
+
+  /**
+   * @brief ProsperoSunshine: set the record hook; call it before init(). Without one every record is written as it is.
+   * @param hook The hook.
+   */
+  void set_record_hook(record_hook_t hook);
+
+  /**
    * @brief The number of previous log files retained during rotation.
    */
   inline constexpr std::size_t retained_log_file_count {5};
