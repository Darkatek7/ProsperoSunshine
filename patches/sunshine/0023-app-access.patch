+
+  /**
+   * @brief Whether the client with this certificate sees the app and may start or resume it: the operator can hide apps
+   * from devices they don't trust (process_ps5.cpp, issue 36).
+   */
+  bool app_allowed(const std::string &client_cert, const ctx_t &app);
+
+  /**
+   * @brief app_allowed() for an app ID, as /launch and /resume get it.
+   */
+  bool app_id_allowed(const std::string &client_cert, int app_id);
 #endif
