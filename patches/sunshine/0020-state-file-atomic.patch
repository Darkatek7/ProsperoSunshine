 // standard includes
+#include <cerrno>
 #include <filesystem>
 #include <fstream>
 
+#ifndef _WIN32
+  // platform includes
+  #include <fcntl.h>
+  #include <unistd.h>
+#endif
+
 // local includes
 #include "file_handler.h"
 #include "logging.h"
@@ -53,4 +60,59 @@
 
     return 0;
   }
+
+  int write_file_atomically(const char *path, const std::string_view &contents) {
+    const std::string temp = std::string {path} + ".tmp";
+    std::error_code ec;
+#ifdef _WIN32
+    if (write_file(temp.c_str(), contents) != 0) {
+      return -1;
+    }
+#else
+    const int fd = ::open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0666);
+    if (fd < 0) {
+      return -1;
+    }
+    std::size_t written = 0;
+    while (written < contents.size()) {
+      const auto n = ::write(fd, contents.data() + written, contents.size() - written);
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n <= 0) {
+        break;
+      }
+      written += static_cast<std::size_t>(n);
+    }
+    const bool synced = written == contents.size() && ::fsync(fd) == 0;
+    if (::close(fd) != 0 || !synced) {
+      std::filesystem::remove(temp, ec);
+      return -1;
+    }
+#endif
+    std::filesystem::rename(temp, path, ec);
+    if (ec) {
+      std::filesystem::remove(temp, ec);
+      return -1;
+    }
+#ifndef _WIN32
+    // The rename is an entry in the directory; sync that too so it survives a power cut.
+    const auto dir = get_parent_directory(path);
+    if (const int dir_fd = ::open(dir.empty() ? "." : dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC); dir_fd >= 0) {
+      ::fsync(dir_fd);
+      ::close(dir_fd);
+    }
+#endif
+    return 0;
+  }
+
+  void set_aside_corrupt(const std::string &path) {
+    std::error_code ec;
+    std::filesystem::rename(path, path + ".corrupt", ec);
+    if (ec) {
+      BOOST_LOG(error) << "Couldn't move " << path << " aside: " << ec.message();
+      return;
+    }
+    BOOST_LOG(warning) << "Moved the unreadable " << path << " to " << path << ".corrupt";
+  }
 }  // namespace file_handler
