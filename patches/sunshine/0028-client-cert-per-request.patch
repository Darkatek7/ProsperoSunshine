+  /**
+   * @brief The paired client that sent a request, from the certificate of the TLS connection the request came on.
+   * @details Each handler asks for it: a process-wide "last verified certificate" set at the end of every handshake could
+   *          be another client's by the time a request arrives (a client may wait up to timeout_request after its
+   *          handshake). The certificate is checked again, as the device may have been unpaired or disabled since.
+   * @return Nothing when the connection is gone or the client is no longer paired and enabled: the handler refuses then.
+   */
+  std::optional<request_client_t> request_client(const req_https_t &request) {
+    const auto socket = request->socket();
+    if (!socket) {
+      return std::nullopt;
+    }
+    crypto::x509_t x509 {
+#if OPENSSL_VERSION_MAJOR >= 3
+      SSL_get1_peer_certificate(socket->native_handle())
+#else
+      SSL_get_peer_certificate(socket->native_handle())
+#endif
+    };
+    if (!x509) {
+      return std::nullopt;
+    }
+    std::lock_guard lock {client_auth_mutex()};
+    if (verify_client_certificate(x509.get())) {
+      return std::nullopt;
+    }
+    auto pem = crypto::pem(x509);
+    auto [enabled, name] = get_client_status(pem);
+    if (!enabled) {
+      return std::nullopt;
+    }
+    return request_client_t {std::move(pem), std::move(name)};
+  }
