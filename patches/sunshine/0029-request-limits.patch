       fresh_sess.async_insert_pin.salt = get_arg(args, "salt");
-      fresh_sess.async_insert_pin.device_name = get_arg(args, "devicename");
+      // Anyone's request: the name is kept for minutes and shown in the app and on the web page, so it is cut to the length an
+      // operator's name may have (pin() refuses a longer one).
+      fresh_sess.async_insert_pin.device_name = prospero::exposure::cap_name(get_arg(args, "devicename"), MAX_PAIRING_CLIENT_NAME_SIZE);
       fresh_sess.async_insert_pin.address = net::addr_to_normalized_string(request->remote_endpoint().address());
