   std::string keyboard_pad_profile_name(const prospero::KeyboardPad &pad) {
-    return std::string(prospero::profile_name(pad.profile()));
+    return pad.own_profile() ? pad.own_profile()->name : std::string(prospero::profile_name(pad.profile()));
