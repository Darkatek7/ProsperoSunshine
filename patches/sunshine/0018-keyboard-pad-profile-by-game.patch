+
+  /**
+   * @brief The keyboard pad profile for the running game.
+   *
+   * ProsperoSunshine: the player's own list (keyboard_profiles.txt), then, with keyboard_mouse_profile_by_game on, the
+   * title map from Wikidata (src/input/title_profiles.hpp), else keyboard_mouse_profile. With no game running (none open,
+   * not even suspended behind the home screen) it is the menu keys, whatever the profile: W A S D on the D-pad. The
+   * running title is sceLncUtilGetAppIdOfRunningBigApp's, so a suspended game keeps its profile in the console's menus,
+   * and an app of the console's such as Settings is a title without one (keyboard_mouse_profile). The game is looked up
+   * at most every two seconds while the keys and the mouse are in use, and its profile and the list anew only when it
+   * changes, so an edited list counts from the next game on.
+   *
+   * @return The profile to play with.
+   */
+  prospero::ProfileChoice keyboard_pad_game_profile() {
+    static std::chrono::steady_clock::time_point checked;
+    static std::string title;
+    static std::string list_text;
+    static prospero::ProfileList list;
+    static prospero::ProfileChoice choice {prospero::Profile::standard, nullptr, prospero::ProfileSource::chosen, true};
+    const auto now = std::chrono::steady_clock::now();
+    if (checked != std::chrono::steady_clock::time_point {} && now - checked < 2s) {
+      return choice;
+    }
+    checked = now;
+    char running[16];
+    const std::string in_front = ps_title_running(running) > 0 ? running : "";
+    if (in_front == title) {
+      return choice;
+    }
+    title = in_front;
+    if (auto text = file_handler::read_file(keyboard_profile_list.c_str()); text != list_text) {
+      list_text = std::move(text);
+      list = prospero::parse_profile_list(list_text);
+      for (const auto &problem : list.problems) {
+        BOOST_LOG(warning) << "keyboard_profiles.txt "sv << problem;
+      }
+    }
+    if (title.empty()) {
+      choice = {prospero::Profile::standard, nullptr, prospero::ProfileSource::chosen, true};
+      BOOST_LOG(info) << "Keyboard pad: menu keys, no game running"sv;
+      return choice;
+    }
+    const auto meta = prospero::read_title_meta("/user", title);
+    choice = prospero::choose_profile(title, meta ? meta->concept_id : 0, meta ? meta->english : "", list, keyboard_pad_profile,
+                                      keyboard_pad_by_game);
+    BOOST_LOG(info) << "Keyboard pad profile "sv << (choice.own ? choice.own->name : std::string(prospero::profile_name(choice.profile)))
+                    << " for "sv << title << ", from "sv << prospero::source_name(choice.source);
+    return choice;
   }
 
