-        BOOST_LOG(warning) << "SSL Verification error :: "sv << err_str;
+        auto fingerprint = certificate_fingerprint(x509.get());
+        auto address = peer_address(ssl);
+        std::size_t held_back = 0;
+        auto line = std::format("SSL Verification error :: {} (client {}{}{})", err_str, fingerprint, address.empty() ? "" : " at ", address);
+        if (verify_error_log.due(fingerprint, std::chrono::steady_clock::now(), held_back)) {
+          if (held_back) {
+            line += std::format(", {} more since the last line", held_back);
+          }
+          BOOST_LOG(warning) << line;
+        } else {
+          BOOST_LOG(debug) << line;
+        }
 
